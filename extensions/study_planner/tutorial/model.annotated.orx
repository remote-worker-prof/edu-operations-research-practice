# Это учебная, подробно прокомментированная версия model.orx.
# Здесь лежит только математическая постановка задачи,
# максимально близкая к тому, как её можно переписать с бумажки или из учебника.

# 1) COURSES — множество курсов.
set COURSES;

# 2) Известные заранее параметры.
# weekly_hours — сколько часов в неделю реально доступно.
param weekly_hours;

# weeks — сколько недель длится план.
param weeks;

# required_hours{COURSES} — сколько часов нужно каждому курсу для полного закрытия.
param required_hours{COURSES};

# priority{COURSES} — насколько важен каждый курс.
param priority{COURSES};

# available_hours — производный scalar-параметр.
# Мы не вводим его руками, а вычисляем внутри модели как weekly_hours * weeks.
param available_hours = weekly_hours * weeks;

# 3) Переменная решения.
# study_hours[c] — сколько часов реально выделить курсу c.
# Ограничения на переменную записаны прямо рядом:
# не меньше 0 и не больше полной потребности required_hours[c].
var study_hours{c in COURSES} >= 0 <= required_hours[c];

# 4) Целевая функция.
# Хотим максимизировать суммарную полезность,
# то есть сумму weight * allocated_hours по всем курсам.
maximize weighted_score:
    sum{c in COURSES} priority[c] * study_hours[c];

# 5) Ограничение бюджета времени.
# Общая сумма выделенных часов не должна превышать available_hours.
subject to total_hours:
    sum{c in COURSES} study_hours[c] <= available_hours;
