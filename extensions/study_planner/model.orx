# Declarative LP teaching model for the study planner sample.

set COURSES

param weekly_hours
param weeks
param required_hours[COURSES]
param priority[COURSES]
param available_hours = weekly_hours * weeks

var study_hours[COURSES] >= 0

maximize weighted_score:
    sum(c in COURSES, priority[c] * study_hours[c])

st total_hours:
    sum(c in COURSES, study_hours[c]) <= available_hours

st course_cap[c in COURSES]:
    study_hours[c] <= required_hours[c]

report total_available_hours = available_hours
report total_required_hours = sum(c in COURSES, required_hours[c])
report total_used_hours = sum(c in COURSES, study_hours[c])
report remaining_hours = available_hours - sum(c in COURSES, study_hours[c])
report achieved_weighted_score = sum(c in COURSES, priority[c] * study_hours[c])

report course_plan[c in COURSES]: {
    course = c,
    required_hours = required_hours[c],
    allocated_hours = study_hours[c],
    gap_hours = required_hours[c] - study_hours[c],
    priority = priority[c],
    completion_ratio = study_hours[c] / required_hours[c],
    completion_ratio_pct = 100 * study_hours[c] / required_hours[c]
}
